{
  "enabled": true,
  "name": "Code Quality Analyzer",
  "description": "Analyzes modified code for potential improvements, including code smells, design patterns, and best practices to enhance readability, maintainability, and performance.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.py"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "You are a senior software architect reviewing a pull request. Your goal is to improve the quality of the code that was just modified, without changing its existing functionality.\n\nFirst, reference the project's `tech.md` and `structure.md` files to understand our specific coding conventions and architectural patterns.\n\nAnalyze the recent changes in this file for critical code smells (like duplicated code or overly complex logic) and opportunities to improve readability and maintainability.\n\nFor each suggestion you have, add a comment directly above the relevant line of code. Start your comment with `// KIRO-SUGGESTION:` and briefly explain the reasoning for the proposed improvement."
  }
}