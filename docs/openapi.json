    "/api/v1/images": {
      "get": {
        "description": "List images with pagination and optional filtering.\n\nSupports filtering by:\n- Direction: \"rx\" (received) or \"tx\" (transmitted)\n- Mode: SSTV mode (e.g., \"MartinM1\", \"ScottieS1\")\n- Callsign: Operator callsign\n\nImages are returned in reverse chronological order (newest first).\n\nQuery Parameters:\n    limit: Number of images per page (1-100, default: 20)\n    offset: Pagination offset (default: 0)\n    direction: Filter by \"rx\" or \"tx\"\n    mode: Filter by SSTV mode\n    callsign: Filter by operator callsign",
        "operationId": "list_images_api_v1_images_get",
        "parameters": [
          {
            "description": "Number of images per page",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "description": "Number of images per page",
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "Pagination offset",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Pagination offset",
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "description": "Filter by direction",
            "in": "query",
            "name": "direction",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^(rx|tx)$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by direction",
              "title": "Direction"
            }
          },
          {
            "description": "Filter by SSTV mode",
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/SSTVMode"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by SSTV mode",
              "title": "Mode"
            }
          },
          {
            "description": "Filter by callsign",
            "in": "query",
            "name": "callsign",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by callsign",
              "title": "Callsign"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Images",
        "tags": [
          "Images",
          "images"
        ]
      }
    },
