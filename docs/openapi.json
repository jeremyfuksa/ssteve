    "/api/v1/transmit": {
      "post": {
        "description": "Start a new SSTV transmission.\n\nEncodes the image, engages PTT (if configured), and transmits the SSTV signal.\nThe transmission duration depends on the SSTV mode selected.\n\nReturns:\n    TransmitResponse with transmission ID and WebSocket URL for real-time updates.\n\nRaises:\n    409 Conflict: If another decode/transmit session is already active (half-duplex)\n    404 Not Found: If image file doesn't exist\n    400 Bad Request: If image format is unsupported or invalid",
        "operationId": "start_transmit_api_v1_transmit_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransmitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransmitResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
