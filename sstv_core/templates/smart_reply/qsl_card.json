{
  "name": "QSL Card",
  "base_image": "qsl_card_base.png",
  "default_mode": "ScottieS1",
  "template_id": "qsl_card",
  "fields": [
    {
      "id": "callsign_received",
      "label": "Their Callsign",
      "x": 50,
      "y": 100,
      "font_size": 32,
      "font_family": "Arial",
      "color": "#FFFFFF",
      "alignment": "left"
    },
    {
      "id": "callsign_operator",
      "label": "Your Callsign",
      "x": 50,
      "y": 150,
      "font_size": 24,
      "color": "#7CFF8A"
    },
    {
      "id": "frequency_mhz",
      "x": 50,
      "y": 200,
      "font_size": 18,
      "color": "#F2B451",
      "format": "{value:.3f} MHz",
      "label": "Frequency"
    },
    {
      "id": "timestamp_utc",
      "x": 50,
      "y": 230,
      "font_size": 16,
      "color": "#5BD6E8",
      "format": "{value:%Y-%m-%d %H:%M UTC}",
      "label": "Timestamp"
    },
    {
      "id": "snr_db",
      "x": 50,
      "y": 260,
      "font_size": 16,
      "color": "#7CFF8A",
      "format": "SNR: {value}dB",
      "label": "Signal Quality"
    }
  ]
}
